     2                                          ; AssilOS, an operating system in 512 bytes
     3                                          ;
     4                                          ; by Oscar Toledo G.
     5                                          ; http://nanochess.org/
     6                                          ; by AssilOS Project
     7                                          ;
     8                                          ; Creation date: Jul/21/2019. 6pm 10pm
     9                                          ; Revision date: Jul/22/2019. Optimization, corrections and comments.
    10                                          ; Revision date: Jul/31/2019. Added a service table and allows
    11                                          ;                             filenames/sources/targets from any segment.
    12                                          ;                             'del' command now shows errors.
    13                                          ;
    14                                  
    15                                          cpu 8086
    16                                  
    17                                          ;
    18                                          ; What is AssilOS:
    19                                          ; 
    20                                          ;   AssilOS is a monolithic operating system that fits in
    21                                          ;   one boot sector. It's able to load, execute, and save
    22                                          ;   programs. Also keeps a filesystem. It can work with
    23                                          ;   any floppy disk size starting at 180K.
    24                                          ; 
    25                                          ;   It relocates itself at 0000:7a00 and requires further
    26                                          ;   768 bytes of memory starting at 0000:7700.
    27                                          ; 
    28                                          ;   This operating system runs programs as boot sectors
    29                                          ;   at 0000:7c00. 
    30                                          ; 
    31                                          ;   It provides the following services:
    32                                          ;      int 0x20   Exit to operating system.
    33                                          ;      int 0x21   Input key and show in screen.
    34                                          ;                 Entry: none
    35                                          ;                 Output: AL = ASCII key pressed.
    36                                          ;                 Affects: AH/BX/BP.
    37                                          ;      int 0x22   Output character to screen.
    38                                          ;                 Entry: AL = Character.
    39                                          ;                 Output: none.
    40                                          ;                 Affects: AH/BX/BP.
    41                                          ;      int 0x23   Load file.
    42                                          ;                 Entry: DS:BX = Filename terminated with zero.
    43                                          ;                        ES:DI = Point to source data (512 bytes)
    44                                          ;                 Output: Carry flag = 0 = Found, 1 = Not found.
    45                                          ;                 Affects: All registers (including ES).
    46                                          ;      int 0x24   Save file.
    47                                          ;                 Entry: DS:BX = Filename terminated with zero.
    48                                          ;                        ES:DI = Point to data target (512 bytes)
    49                                          ;                 Output: Carry flag = 0 = Successful. 1 = Error.
    50                                          ;                 Affects: All registers (including ES).
    51                                          ;      int 0x25   Delete file.
    52                                          ;                 Entry: DS:BX = Filename terminated with zero.
    53                                          ;                 Affects: All registers (including ES).
    54                                          ;
    55                                          ; 
    56                                          ; Filesystem organization:
    57                                          ;
    58                                          ;   AssilOS uses tracks from 0 to 32, side 0, sector 1.
    59                                          ;
    60                                          ;   The directory is contained in track 0, side 0, sector 2.
    61                                          ;
    62                                          ;   Each entry in the directory is 16 bytes wide, and
    63                                          ;   contains the ASCII name of the file finished with a
    64                                          ;   zero byte. A sector has a capacity of 512 bytes, it
    65                                          ;   means only 32 files can be kept on a floppy disk.
    66                                          ;
    67                                          ;   Deleting a file is a matter of zeroing a whole entry.
    68                                          ;
    69                                          ;   Each file is one sector long. Its location in the
    70                                          ;   disk is derived from its position in the directory.
    71                                          ;
    72                                          ;   The 1st file is located at track 1, side 0, sector 1.
    73                                          ;   The 2nd file is located at track 2, side 0, sector 1.
    74                                          ;   The 32nd file is located at track 32, side 0, sector 1.
    75                                          ;
    76                                          ;
    77                                          ; Starting AssilOS:
    78                                          ;
    79                                          ;   Just make sure to write it at the boot sector of a
    80                                          ;   floppy disk. It can work with any floppy disk size
    81                                          ;   (360K, 720K, 1.2MB and 1.44MB) and it will waste the
    82                                          ;   disk space as only uses the first two sectors of the
    83                                          ;   disk and then the first sector of each following
    84                                          ;   track.
    85                                          ;
    86                                          ;   For emulation make sure to deposit it at the start
    87                                          ;   of a .img file of 360K, 720K or 1440K. (at least
    88                                          ;   VirtualBox detects the type of disk by the length
    89                                          ;   of the image file)
    90                                          ;
    91                                          ;   For Mac OS X and Linux you can create a 360K image
    92                                          ;   in this way:
    93                                          ; 
    94                                          ;     dd if=/dev/zero of=oszero.img count=719 bs=512
    95                                          ;     cat os.img oszero.img >osbase.img
    96                                          ; 
    97                                          ;   Replace 719 with 1439 for 720K, or 2879 for 1.44M.
    98                                          ; 
    99                                          ;   Tested with VirtualBox for Mac OS X running Windows XP
   100                                          ;   running it, it also works with qemu:
   101                                          ; 
   102                                          ;     qemu-system-x86_64 -fda os.img
   103                                          ; 
   104                                          ; Running AssilOS:
   105                                          ;
   106                                          ;   The first time you should enter the 'format' command,
   107                                          ;   so it initializes the directory. It also copies itself
   108                                          ;   again to the boot sector, this is useful to init new
   109                                          ;   disks.
   110                                          ;
   111                                          ; AssilOSOS commands:
   112                                          ;
   113                                          ;   ver           Shows the version (none at the moment)
   114                                          ;   dir           Shows the directory's content.
   115                                          ;   del filename  Deletes the "filename" file.
   116                                          ;   format        As explained before.
   117                                          ;   enter         Allows to enter up to 512 hexadecimal
   118                                          ;                 bytes to create another file.
   119                                          ;
   120                                          ;                 Notice the line size is 128 characters so
   121                                          ;                 you must break the input into chunks of
   122                                          ;                 4, 8 or 16 bytes.
   123                                          ;
   124                                          ;                 It also allows to copy the last executed
   125                                          ;                 program just press Enter when the 'h' prompt
   126                                          ;                 appears and type the new name.
   127                                          ;
   128                                          ; For example: (Character + is Enter key)
   129                                          ;   
   130                                          ;   $enter+
   131                                          ;   hbb 17 7c 8a 07 84 c0 74 0c 53 b4 0e bb 0f 00 cd+
   132                                          ;   h10 5b 43 eb ee cd 20 48 65 6c 6c 6f 2c 20 77 6f+
   133                                          ;   h72 6c 64 0d 0a 00+
   134                                          ;   h+
   135                                          ;   *hello+
   136                                          ;   $dir+
   137                                          ;   hello
   138                                          ;   $hello+
   139                                          ;   Hello, world
   140                                          ;   $
   141                                          ;
   142                                          ; bootOS programs: (Oh yes! we have software support)
   143                                          ;
   144                                          ;   fbird         https://github.com/nanochess/fbird
   145                                          ;   Pillman       https://github.com/nanochess/pillman
   146                                          ;   invaders      https://github.com/nanochess/invaders
   147                                          ;   bootBASIC     https://github.com/nanochess/bootBASIC
   148                                          ;
   149                                          ; You can copy the machine code directly using the 'enter'
   150                                          ; command, or you can create a file with signature bytes
   151                                          ; with the same command and later copy the binary into the
   152                                          ; .img file using the signature bytes as a clue to locate
   153                                          ; the right position in the image file.
   154                                          ;
   155                                          ; Or you can find a pre-designed disk image along this Git
   156                                          ; with the name osall.img
   157                                          ;
   158                                  
   159                                  stack:  equ 0x7700      ; Stack pointer (grows to lower addresses)
   160                                  line:   equ 0x7780      ; Buffer for line input
   161                                  sector: equ 0x7800      ; Sector data for directory
   162                                  osbase: equ 0x7a00      ; bootOS location
   163                                  boot:   equ 0x7c00      ; Boot sector location  
   164                                  
   165                                  entry_size:     equ 16  ; Directory entry size
   166                                  sector_size:    equ 512 ; Sector size
   167                                  max_entries:    equ sector_size/entry_size
   168                                  
   169                                          ;
   170                                          ; Cold start of AssilOS
   171                                          ;
   172                                          ; Notice it is loaded at 0x7c00 (boot) and needs to
   173                                          ; relocate itself to 0x7a00 (osbase). The instructions
   174                                          ; between 'start' and 'ver_command' shouldn't depend
   175                                          ; on the assembly location (osbase) because these
   176                                          ; are running at boot location (boot).
   177                                          ;
   178                                          org osbase
   179                                  start:
   180 00000000 31C0                            xor ax,ax       ; Set all segments to zero
   181 00000002 8ED8                            mov ds,ax
   182 00000004 8EC0                            mov es,ax
   183 00000006 8ED0                            mov ss,ax
   184 00000008 BC0077                          mov sp,stack    ; Set stack to guarantee data safety
   185                                  
   186 0000000B FC                              cld             ; Clear D flag.
   187 0000000C BE007C                          mov si,boot     ; Copy AssilOS boot sector...
   188 0000000F BF007A                          mov di,osbase   ; ...into osbase
   189 00000012 B90002                          mov cx,sector_size
   190 00000015 F3A4                            rep movsb
   191                                  
   192                                          ; NOTE: we could avoid the need for setting SI here
   193                                          ; by adjusting the length of the copy above, but that
   194                                          ; would break the 'format' command.
   195 00000017 BE[F101]                        mov si,int_0x20 ; SI now points to int_0x20
   196 0000001A BF8000                          mov di,0x0020*4 ; Address of service for int 0x20
   197 0000001D B106                            mov cl,6
   198                                  .load_vec:
   199 0000001F A5                              movsw           ; Copy IP address
   200 00000020 AB                              stosw           ; Copy CS address
   201 00000021 E2FC                            loop .load_vec
   202                                  
   203                                          ;
   204                                          ; 'ver' command
   205                                          ;
   206                                  ver_command:
   207 00000023 BE[B401]                        mov si,intro
   208                                  print_then_restart:
   209 00000026 E83E01                          call output_string
   210 00000029 CD20                            int int_restart ; Restart bootOS
   211                                  
   212                                          ;
   213                                          ; Warm start of AssilOS
   214                                          ;
   215                                  restart:
   216 0000002B FC                              cld             ; Clear D flag.
   217 0000002C 0E                              push cs         ; Reinit all segment registers
   218 0000002D 0E                              push cs
   219 0000002E 0E                              push cs
   220 0000002F 1F                              pop ds
   221 00000030 07                              pop es
   222 00000031 17                              pop ss
   223 00000032 BC0077                          mov sp,stack    ; Restart stack
   224                                  
   225 00000035 B024                            mov al,'$'      ; Command prompt
   226 00000037 E8FE00                          call input_line ; Input line
   227                                  
   228 0000003A 803C00                          cmp byte [si],0x00  ; Empty line?
   229 0000003D 74EC                            je restart          ; Yes, get another line
   230                                  
   231 0000003F BF[CB01]                        mov di,commands ; Point to commands list
   232                                  
   233                                          ; Notice that filenames starting with same characters
   234                                          ; won't be recognized as such (so file dirab cannot be
   235                                          ; executed).
   236                                  os11:
   237 00000042 8A0D                            mov cl,[di]     ; Read length of command in chars
   238 00000044 47                              inc di
   239 00000045 30ED                            xor ch, ch      ; Also makes sure that ZF = 1
   240 00000047 56                              push si         ; Save current position
   241 00000048 F3A6                            rep cmpsb       ; Compare statement
   242 0000004A 7504                            jne os14        ; Equal? No, jump
   243 0000004C FF15                            call word [di]  ; Call command process
   244 0000004E EBDB                            jmp restart     ; Go to expect another command
   245                                  
   246 00000050 01CF                    os14:   add di,cx       ; Advance the list pointer
   247 00000052 AF                              scasw           ; Avoid the address
   248 00000053 5E                              pop si
   249 00000054 EBEC                            jmp os11        ; Compare another statement
   250                                  
   251                                  exec_from_disk:
   252 00000056 5B                              pop bx
   253 00000057 5B                              pop bx
   254 00000058 BF007C                          mov di,boot     ; Location to read data
   255 0000005B CD23                            int int_load_file       ; Load file
   256 0000005D 7202                            jc os7          ; Jump if error
   257 0000005F FFE3                            jmp bx
   258                                  
   259                                          ;
   260                                          ; File not found error
   261                                          ;
   262                                  os7:
   263 00000061 BE[BC01]                        mov si,error_message
   264 00000064 EBC0                            jmp print_then_restart
   265                                  
   266                                          ;
   267                                          ; >> COMMAND <<
   268                                          ; del filename
   269                                          ;
   270                                  del_command:
   271                                  os22:
   272 00000066 89F3                            mov bx,si       ; Copy SI (buffer pointer) to BX
   273 00000068 AC                              lodsb
   274 00000069 3C20                            cmp al,0x20     ; Avoid spaces
   275 0000006B 74F9                            je os22
   276 0000006D CD25                            int int_delete_file
   277 0000006F 72F0                            jc os7
   278 00000071 C3                              ret
   279                                  
   280                                          ;
   281                                          ; 'dir' command
   282                                          ;
   283                                  dir_command:
   284 00000072 E8A000                          call read_dir           ; Read the directory
   285 00000075 89DF                            mov di,bx
   286                                  os18:
   287 00000077 803D00                          cmp byte [di],0         ; Empty entry?
   288 0000007A 7405                            je os17                 ; Yes, jump
   289 0000007C 89FE                            mov si,di               ; Point to data
   290 0000007E E8E600                          call output_string      ; Show name
   291 00000081 E86E00                  os17:   call next_entry
   292 00000084 75F1                            jne os18                ; No, jump
   293 00000086 C3                              ret                     ; Return
   294                                  
   295                                          ;
   296                                          ; Get filename length and prepare for directory lookup
   297                                          ; Entry:
   298                                          ;   si = pointer to string
   299                                          ; Output:
   300                                          ;   si = unaffected
   301                                          ;   di = pointer to start of directory
   302                                          ;   cx = length of filename including zero terminator
   303                                          ;
   304                                  filename_length:
   305 00000087 56                              push si
   306 00000088 31C9                            xor cx,cx       ; cx = 0
   307                                  .loop:
   308 0000008A AC                              lodsb           ; Read character.
   309 0000008B 41                              inc cx          ; Count character.
   310 0000008C 3C00                            cmp al,0        ; Is it zero (end character)?
   311 0000008E 75FA                            jne .loop       ; No, jump.
   312                                  
   313 00000090 5E                              pop si
   314 00000091 BF0078                          mov di,sector   ; Point to start of directory.
   315 00000094 C3                              ret
   316                                          
   317                                          ;
   318                                          ; >> SERVICE <<
   319                                          ; Load file
   320                                          ;
   321                                          ; Entry:
   322                                          ;   ds:bx = Pointer to filename ended with zero byte.
   323                                          ;   es:di = Destination.
   324                                          ; Output:
   325                                          ;   Carry flag = Set = not found, clear = successful.
   326                                          ;
   327                                  load_file:
   328 00000095 57                              push di         ; Save destination
   329 00000096 06                              push es
   330 00000097 E84000                          call find_file  ; Find the file (sanitizes ES)
   331 0000009A B402                            mov ah,0x02     ; Read sector
   332                                  shared_file:
   333 0000009C 07                              pop es
   334 0000009D 5B                              pop bx          ; Restore destination on BX
   335 0000009E 7203                            jc ret_cf       ; Jump if error
   336 000000A0 E88400                          call disk       ; Do operation with disk
   337                                                          ; Carry guaranteed to be clear.
   338                                  ret_cf:
   339 000000A3 89E5                            mov bp,sp
   340 000000A5 D05604                          rcl byte [bp+4],1       ; Insert Carry flag in Flags (automatic usage of SS)
   341 000000A8 CF                              iret
   342                                  
   343                                          ;
   344                                          ; >> SERVICE <<
   345                                          ; Save file
   346                                          ;
   347                                          ; Entry:
   348                                          ;   ds:bx = Pointer to filename ended with zero byte.
   349                                          ;   es:di = Source.
   350                                          ; Output:
   351                                          ;   Carry flag = Set = error, clear = good.
   352                                          ;
   353                                  save_file:
   354 000000A9 57                              push di                 ; Save origin
   355 000000AA 06                              push es
   356 000000AB 53                              push bx                 ; Save filename pointer
   357 000000AC CD25                            int int_delete_file     ; Delete previous file (sanitizes ES)
   358 000000AE 5B                              pop bx                  ; Restore filename pointer
   359 000000AF E8D5FF                          call filename_length    ; Prepare for lookup
   360                                  
   361 000000B2 26803D00                .find:  es cmp byte [di],0      ; Found empty directory entry?
   362 000000B6 7407                            je .empty               ; Yes, jump and fill it.
   363 000000B8 E83700                          call next_entry
   364 000000BB 75F5                            jne .find
   365 000000BD EBDD                            jmp shared_file
   366                                  
   367 000000BF 57                      .empty: push di
   368 000000C0 F3A4                            rep movsb               ; Copy full name into directory
   369 000000C2 E85A00                          call write_dir          ; Save directory
   370 000000C5 5F                              pop di
   371 000000C6 E83200                          call get_location       ; Get location of file
   372 000000C9 B403                            mov ah,0x03             ; Write sector
   373 000000CB EBCF                            jmp shared_file
   374                                  
   375                                          ;
   376                                          ; >> SERVICE <<
   377                                          ; Delete file
   378                                          ;
   379                                          ; Entry:
   380                                          ;   ds:bx = Pointer to filename ended with zero byte.
   381                                          ; Output:
   382                                          ;   Carry flag = Set = not found, clear = deleted.
   383                                          ;
   384                                  delete_file:
   385 000000CD E80A00                          call find_file          ; Find file (sanitizes ES)
   386 000000D0 72D1                            jc ret_cf               ; If carry set then not found, jump.
   387 000000D2 B91000                          mov cx,entry_size
   388 000000D5 E84300                          call write_zero_dir     ; Fill whole entry with zero. Write directory.
   389 000000D8 EBC9                            jmp ret_cf
   390                                  
   391                                          ;
   392                                          ; Find file
   393                                          ;
   394                                          ; Entry:
   395                                          ;   ds:bx = Pointer to filename ended with zero byte.
   396                                          ; Output:
   397                                          ;   es:di = Pointer to directory entry
   398                                          ;   Carry flag = Clear if found, set if not found.
   399                                  find_file:
   400 000000DA 53                              push bx
   401 000000DB E83700                          call read_dir   ; Read directory (sanitizes ES)
   402 000000DE 5E                              pop si
   403 000000DF E8A5FF                          call filename_length    ; Get filename length and setup DI
   404                                  os6:
   405 000000E2 56                              push si
   406 000000E3 57                              push di
   407 000000E4 51                              push cx
   408 000000E5 F3A6                            repe cmpsb      ; Compare name with entry
   409 000000E7 59                              pop cx
   410 000000E8 5F                              pop di
   411 000000E9 5E                              pop si
   412 000000EA 740F                            je get_location ; Jump if equal.
   413 000000EC E80300                          call next_entry
   414 000000EF 75F1                            jne os6         ; No, jump
   415 000000F1 C3                              ret             ; Return
   416                                  
   417                                  next_entry:
   418 000000F2 83C710                          add di,byte entry_size          ; Go to next entry.
   419 000000F5 81FF007A                        cmp di,sector+sector_size       ; Complete directory?
   420 000000F9 F9                              stc                             ; Error, not found.
   421 000000FA C3                              ret
   422                                  
   423                                          ;
   424                                          ; Get location of file on disk
   425                                          ;
   426                                          ; Entry:
   427                                          ;   DI = Pointer to entry in directory.
   428                                          ;
   429                                          ; Output:
   430                                          ;   CH = Track number in disk.
   431                                          ;   CL = Sector (always 0x01).
   432                                          ;
   433                                          ; The position of a file inside the disk depends on its
   434                                          ; position in the directory. The first entry goes to
   435                                          ; track 1, the second entry to track 2 and so on.
   436                                          ;
   437                                  get_location:
   438 000000FB 8D851088                        lea ax,[di-(sector-entry_size)] ; Get entry pointer into directory
   439                                                          ; Plus one entry (files start on track 1)
   440 000000FF B104                            mov cl,4        ; 2^(8-4) = entry_size
   441 00000101 D3E0                            shl ax,cl       ; Shift left and clear Carry flag
   442 00000103 40                              inc ax          ; AL = Sector 1
   443 00000104 91                              xchg ax,cx      ; CH = Track, CL = Sector
   444 00000105 C3                              ret
   445                                  
   446                                          ;
   447                                          ; >> COMMAND <<
   448                                          ; format
   449                                          ;
   450                                  format_command:
   451 00000106 BF0078                          mov di,sector   ; Fill whole sector to zero
   452 00000109 B90002                          mov cx,sector_size
   453 0000010C E80C00                          call write_zero_dir
   454 0000010F BB007A                          mov bx,osbase   ; Copy AssilOS onto first sector
   455 00000112 49                              dec cx
   456 00000113 EB12                            jmp short disk
   457                                  
   458                                          ;
   459                                          ; Read the directory from disk
   460                                          ;
   461                                  read_dir:
   462 00000115 0E                              push cs         ; AssilOS code segment...
   463 00000116 07                              pop es          ; ...to sanitize ES register
   464 00000117 B402                            mov ah,0x02
   465 00000119 EB06                            jmp short disk_dir
   466                                  
   467                                  write_zero_dir:
   468 0000011B B000                            mov al,0
   469 0000011D F3AA                            rep stosb
   470                                  
   471                                          ;
   472                                          ; Write the directory to disk
   473                                          ;
   474                                  write_dir:
   475 0000011F B403                            mov ah,0x03
   476                                  disk_dir:
   477 00000121 BB0078                          mov bx,sector
   478 00000124 B90200                          mov cx,0x0002
   479                                          ;
   480                                          ; Do disk operation.
   481                                          ;
   482                                          ; Input:
   483                                          ;   AH = 0x02 read disk, 0x03 write disk
   484                                          ;   ES:BX = data source/target
   485                                          ;   CH = Track number
   486                                          ;   CL = Sector number
   487                                          ;
   488                                  disk:
   489 00000127 50                              push ax
   490 00000128 53                              push bx
   491 00000129 51                              push cx
   492 0000012A 06                              push es
   493 0000012B B001                            mov al,0x01     ; AL = 1 sector
   494 0000012D 31D2                            xor dx,dx       ; DH = Drive A. DL = Head 0.
   495 0000012F CD13                            int 0x13
   496 00000131 07                              pop es
   497 00000132 59                              pop cx
   498 00000133 5B                              pop bx
   499 00000134 58                              pop ax
   500 00000135 72F0                            jc disk         ; Retry
   501 00000137 C3                              ret
   502                                  
   503                                          ;
   504                                          ; Input line from keyboard
   505                                          ; Entry:
   506                                          ;   al = prompt character
   507                                          ; Output:
   508                                          ;   buffer 'line' contains line, finished with CR
   509                                          ;   SI points to 'line'.
   510                                          ;
   511                                  input_line:
   512 00000138 CD22                            int int_output_char ; Output prompt character
   513 0000013A BE8077                          mov si,line     ; Setup SI and DI to start of line buffer
   514 0000013D 89F7                            mov di,si       ; Target for writing line
   515 0000013F 3C08                    os1:    cmp al,0x08     ; Backspace?
   516 00000141 7502                            jne os2
   517 00000143 4F                              dec di          ; Undo the backspace write
   518 00000144 4F                              dec di          ; Erase a character
   519 00000145 CD21                    os2:    int int_input_key  ; Read keyboard
   520 00000147 3C0D                            cmp al,0x0d     ; CR pressed?
   521 00000149 7502                            jne os10
   522 0000014B B000                            mov al,0x00
   523 0000014D AA                      os10:   stosb           ; Save key in buffer
   524 0000014E 75EF                            jne os1         ; No, wait another key
   525 00000150 C3                              ret             ; Yes, return
   526                                  
   527                                          ;
   528                                          ; Read a key into al
   529                                          ; Also outputs it to screen
   530                                          ;
   531                                  input_key:
   532 00000151 B400                            mov ah,0x00
   533 00000153 CD16                            int 0x16
   534                                          ;
   535                                          ; Screen output of character contained in al
   536                                          ; Expands 0x0d (CR) into 0x0a 0x0d (LF CR)
   537                                          ;
   538                                  output_char:
   539 00000155 3C0D                            cmp al,0x0d
   540 00000157 7506                            jne os3
   541 00000159 B00A                            mov al,0x0a
   542 0000015B CD22                            int int_output_char
   543 0000015D B00D                            mov al,0x0d
   544                                  os3:
   545 0000015F B40E                            mov ah,0x0e     ; Output character to TTY
   546 00000161 BB0700                          mov bx,0x0007   ; Gray. Required for graphic modes
   547 00000164 CD10                            int 0x10        ; BIOS int 0x10 = Video
   548 00000166 CF                              iret
   549                                  
   550                                          ;
   551                                          ; Output string
   552                                          ;
   553                                          ; Entry:
   554                                          ;   SI = address
   555                                          ;
   556                                          ; Implementation:
   557                                          ;   It assumes that SI never points to a zero length string.
   558                                          ;
   559                                  output_string:
   560 00000167 AC                              lodsb                   ; Read character
   561 00000168 CD22                            int int_output_char     ; Output to screen
   562 0000016A 3C00                            cmp al,0x00             ; Is it 0x00 (terminator)?
   563 0000016C 75F9                            jne output_string       ; No, the loop continues
   564 0000016E B00D                            mov al,0x0d
   565 00000170 CD22                            int int_output_char
   566 00000172 C3                              ret
   567                                  
   568                                          ;
   569                                          ; 'enter' command
   570                                          ;
   571                                  enter_command:
   572 00000173 BF007C                          mov di,boot             ; Point to boot sector
   573 00000176 57                      os23:   push di
   574 00000177 B068                            mov al,'h'              ; Prompt character
   575 00000179 E8BCFF                          call input_line         ; Input line
   576 0000017C 5F                              pop di
   577 0000017D 803C00                          cmp byte [si],0         ; Empty line?
   578 00000180 7412                            je os20                 ; Yes, jump
   579 00000182 E81C00                  os19:   call xdigit             ; Get a hexadecimal digit
   580 00000185 73EF                            jnc os23
   581 00000187 B104                            mov cl,4
   582 00000189 D2E0                            shl al,cl
   583 0000018B 91                              xchg ax,cx
   584 0000018C E81200                          call xdigit             ; Get a hexadecimal digit
   585 0000018F 08C8                            or al,cl
   586 00000191 AA                              stosb                   ; Write one byte
   587 00000192 EBEE                            jmp os19                ; Repeat loop to complete line
   588                                  os20:        
   589 00000194 B02A                            mov al,'*'              ; Prompt character
   590 00000196 E89FFF                          call input_line         ; Input line with filename
   591 00000199 56                              push si
   592 0000019A 5B                              pop bx
   593 0000019B BF007C                          mov di,boot             ; Point to data entered
   594 0000019E CD24                            int int_save_file       ; Save new file
   595 000001A0 C3                              ret
   596                                  
   597                                          ;
   598                                          ; Convert ASCII letter to hexadecimal digit
   599                                          ;
   600                                  xdigit:
   601 000001A1 AC                              lodsb
   602 000001A2 3C00                            cmp al,0x00             ; Zero character marks end of line
   603 000001A4 740D                            je os15
   604 000001A6 2C30                            sub al,0x30             ; Avoid spaces (anything below ASCII 0x30)
   605 000001A8 72F7                            jc xdigit
   606 000001AA 3C0A                            cmp al,0x0a
   607 000001AC 7205                            jc os15
   608 000001AE 2C07                            sub al,0x07
   609 000001B0 240F                            and al,0x0f
   610 000001B2 F9                              stc
   611                                  os15:
   612 000001B3 C3                              ret
